{
    "elements": [
        {
            "type": "Label",
            "caption": "Eine Zeitschaltuhr mit beliebig vielen Schaltpunkten. Jeder Punkt hat eine feste Uhrzeit oder richtet sich nach Sonnenauf- bzw. -untergang, und schreibt auf eine Variable oder ruft eine Szene auf."
        },
        {
            "type": "Select",
            "name": "Mode",
            "caption": "Art",
            "options": [
                {
                    "caption": "Tagesuhr — jeden Tag gleich",
                    "value": 0
                },
                {
                    "caption": "Wochenuhr — je Punkt eigene Wochentage",
                    "value": 1
                }
            ]
        },
        {
            "type": "List",
            "name": "Points",
            "caption": "Schaltpunkte",
            "rowCount": 10,
            "add": true,
            "delete": true,
            "changeOrder": true,
            "columns": [
                {
                    "caption": "Aktiv",
                    "name": "Active",
                    "width": "70px",
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Tage",
                    "name": "Tage",
                    "width": "150px",
                    "add": ""
                },
                {
                    "caption": "Zeit",
                    "name": "Zeit",
                    "width": "150px",
                    "add": ""
                },
                {
                    "caption": "Ziel",
                    "name": "Ziel",
                    "width": "auto",
                    "add": ""
                },
                {
                    "caption": "Mo",
                    "name": "D1",
                    "width": "10px",
                    "visible": false,
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Di",
                    "name": "D2",
                    "width": "10px",
                    "visible": false,
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Mi",
                    "name": "D3",
                    "width": "10px",
                    "visible": false,
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Do",
                    "name": "D4",
                    "width": "10px",
                    "visible": false,
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Fr",
                    "name": "D5",
                    "width": "10px",
                    "visible": false,
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Sa",
                    "name": "D6",
                    "width": "10px",
                    "visible": false,
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "So",
                    "name": "D7",
                    "width": "10px",
                    "visible": false,
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Zeitart",
                    "name": "TimeType",
                    "width": "10px",
                    "visible": false,
                    "add": 0,
                    "edit": {
                        "type": "Select",
                        "options": [
                            {
                                "caption": "Feste Uhrzeit",
                                "value": 0
                            },
                            {
                                "caption": "Sonnenaufgang",
                                "value": 1
                            },
                            {
                                "caption": "Sonnenuntergang",
                                "value": 2
                            }
                        ]
                    }
                },
                {
                    "caption": "Uhrzeit",
                    "name": "Time",
                    "width": "10px",
                    "visible": false,
                    "add": "{\"hour\":18,\"minute\":0,\"second\":0}",
                    "edit": {
                        "type": "SelectTime"
                    }
                },
                {
                    "caption": "Verschiebung",
                    "name": "Offset",
                    "width": "10px",
                    "visible": false,
                    "add": 0,
                    "edit": {
                        "type": "NumberSpinner",
                        "minimum": -720,
                        "maximum": 720,
                        "suffix": "min"
                    }
                },
                {
                    "caption": "Zielobjekt",
                    "name": "TargetID",
                    "width": "10px",
                    "visible": false,
                    "add": 0,
                    "edit": {
                        "type": "SelectObject"
                    }
                },
                {
                    "caption": "Zielwert",
                    "name": "Value",
                    "width": "10px",
                    "visible": false,
                    "add": "null",
                    "edit": {
                        "type": "SelectValue"
                    }
                }
            ],
            "form": [
                "return json_decode(RGSZU_Zeilenformular($id, (int) ($Points['TargetID'] ?? 0), (int) ($Points['TimeType'] ?? 0), (int) $Mode), true);"
            ]
        },
        {
            "type": "CheckBox",
            "name": "EditInTile",
            "caption": "Schaltpunkte in der Kachel bedienbar machen"
        },
        {
            "type": "Label",
            "caption": "Dann stehen Uhrzeit, Wochentage und der Schalter jedes Punktes in der Visualisierung. Das Ziel bleibt hier — dafür braucht es den Objektbaum."
        },
        {
            "type": "ExpansionPanel",
            "caption": "Standort für Sonnenauf- und -untergang",
            "items": [
                {
                    "type": "Label",
                    "caption": "Ohne Angabe nimmt die Uhr die Standort-Instanz von Symcon."
                },
                {
                    "type": "SelectInstance",
                    "name": "LocationInstance",
                    "caption": "Standort"
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Neu planen",
            "onClick": "RGSZU_Planen($id); echo RGSZU_NaechsteSchaltung($id);"
        }
    ],
    "status": []
}
