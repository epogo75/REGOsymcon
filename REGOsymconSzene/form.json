{
    "elements": [
        {
            "type": "Label",
            "caption": "Eine Szene: beim Aufrufen bekommen alle Mitglieder ihren Zielwert. „Speichern“ übernimmt dafür den aktuellen Zustand."
        },
        {
            "type": "Label",
            "caption": "Aus einem Raum lassen sich alle bedienbaren Variablen der REGOsymcon-Kacheln auf einmal übernehmen — Schalten, Helligkeit, Rollladenposition und Soll-Temperatur."
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "SelectCategory",
                    "name": "RoomCategory",
                    "caption": "Raum"
                },
                {
                    "type": "Button",
                    "caption": "Mitglieder aus Raum übernehmen",
                    "onClick": "echo RGSSZ_MitgliederAusRaum($id, $RoomCategory) . ' Mitglieder übernommen.';"
                }
            ]
        },
        {
            "type": "List",
            "name": "Members",
            "caption": "Mitglieder",
            "rowCount": 12,
            "add": true,
            "delete": true,
            "changeOrder": true,
            "columns": [
                {
                    "caption": "Aktiv",
                    "name": "Active",
                    "width": "70px",
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "caption": "Variable",
                    "name": "VariableID",
                    "width": "auto",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Zielwert",
                    "name": "Anzeige",
                    "width": "160px",
                    "add": ""
                },
                {
                    "caption": "Wert",
                    "name": "Value",
                    "width": "10px",
                    "visible": false,
                    "add": "null",
                    "edit": {
                        "type": "SelectValue"
                    }
                },
                {
                    "caption": "Verzögerung",
                    "name": "Delay",
                    "width": "130px",
                    "add": 0,
                    "edit": {
                        "type": "NumberSpinner",
                        "minimum": 0,
                        "maximum": 60000,
                        "suffix": "ms"
                    }
                }
            ],
            "form": [
                "return json_decode(RGSSZ_Zeilenformular($id, (int) ($Members['VariableID'] ?? 0)), true);"
            ]
        },
        {
            "type": "CheckBox",
            "name": "OnlyChanged",
            "caption": "Nur schreiben, was abweicht"
        },
        {
            "type": "ValidationTextBox",
            "name": "Label",
            "caption": "Beschriftung des Knopfs"
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Szene aufrufen",
            "onClick": "RGSSZ_Aufrufen($id);"
        },
        {
            "type": "Button",
            "caption": "Aktuellen Zustand speichern",
            "onClick": "RGSSZ_Speichern($id); echo 'Zielwerte übernommen.';"
        }
    ]
}
